# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL for all backend API calls.
VITE_API_BASE_URL=http://localhost:8000/api/

# ─── Entra ID (Azure AD) ──────────────────────────────────────────────────────
# Backend-initiated OIDC flow: the frontend redirects here, the backend redirects
# to Entra and completes the code exchange at ENTRA_REDIRECT_URI, then returns
# the user to the app with a session/token.
#
# The Entra tenant id, client id and client secret are BACKEND configuration and
# must never be placed in a VITE_ variable — everything prefixed with VITE_ is
# inlined into the public browser bundle.
#
# ENTRA_TENANT_ID=de90fc9b-bc42-4637-b66d-302fd2975656
# ENTRA_CLIENT_ID=7a227dfb-0924-4f87-8f76-b9c99f09f1f5
# ENTRA_CLIENT_SECRET=<backend only — never commit or expose to the browser>
# ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
# ENTRA_OIDC_DISCOVERY_URL=

# Endpoint that starts the Entra sign-in redirect.
# Defaults to "${VITE_API_BASE_URL}auth/oidc/login" when unset.
VITE_ENTRA_LOGIN_URL=http://localhost:8000/api/auth/oidc/login
